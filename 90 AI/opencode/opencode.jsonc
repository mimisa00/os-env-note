{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "grep": "allow",
    "glob": "allow",
    "skill": "allow",
    "question": "allow",
    "playwright_*": "deny",
    "context7_*": "deny"
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "@tarquinen/opencode-dcp@latest",
    "@kdcokenny/opencode-worktree",
    //"oh-my-openagent@latest"
  ],
  "model": "llama/Qwen3.8-27B",
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama Local",
      "options": {
        "baseURL": "http://192.168.250.159:8000/v1",
        "apiKey": "llama"
      },
      "models": {
        "Qwen3.8-27B": {
          "name": "Qwen3.8-27B (default)",
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "variants": {
            "fast": {
              "body": {
                "temperature": 0.7,
                "top_p": 0.80,
                "top_k": 20,
                "min_p": 0.0,
                "presence_penalty": 1.5,
                "repetition_penalty": 1.0,
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            },
            "low": {
              "body": {
                "temperature": 1.0,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0.0,
                "presence_penalty": 0.0,
                "repetition_penalty": 1.0,
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "reasoning_effort": "low"
                }
              }
            },
            "medium": {
              "body": {
                "temperature": 1.0,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0.0,
                "presence_penalty": 0.0,
                "repetition_penalty": 1.0,
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "reasoning_effort": "medium"
                }
              }
            },
            "xhigh": {
              "body": {
                "temperature": 1.0,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0.0,
                "presence_penalty": 0.0,
                "repetition_penalty": 1.0,
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "reasoning_effort": "xhigh"
                }
              }
            }
          },
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "capabilities": {
            "input": {
              "image": true
            }
          }
        },
        "Qwen3.8-27B-fast": {
          "name": "Qwen3.8-27B (fast)",
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "temperature": 0.7,
            "top_p": 0.80,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 1.5,
            "repetition_penalty": 1.0,
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "capabilities": {
            "input": {
              "image": true
            }
          }
        },
        "Qwen3.8-27B-low": {
          "name": "Qwen3.8-27B (low)",
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0,
            "chat_template_kwargs": {
              "enable_thinking": true,
              "reasoning_effort": "low"
            }
          },
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "capabilities": {
            "input": {
              "image": true
            }
          }
        },
        "Qwen3.8-27B-medium": {
          "name": "Qwen3.8-27B (medium)",
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0,
            "chat_template_kwargs": {
              "enable_thinking": true,
              "reasoning_effort": "medium"
            }
          },
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "capabilities": {
            "input": {
              "image": true
            }
          }
        },
        "Qwen3.8-27B-xhigh": {
          "name": "Qwen3.8-27B (xhigh)",
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0,
            "chat_template_kwargs": {
              "enable_thinking": true,
              "reasoning_effort": "xhigh"
            }
          },
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "capabilities": {
            "input": {
              "image": true
            }
          }
        }
      }
    },
  },
  "mcp": {
    // 賦予 opencode 網頁點擊能力,僅供 qa agent 在驗證階段使用
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--isolated", // 每次 session 用乾淨的 browser context,不留 cookie/localStorage,QA 不該汙染真實登入態
        "--headless", // 沒有桌面環境的機器/CI 上必要
        "--caps=tabs,storage", // 新增:tabs 給目前分頁/URL,storage 給 cookie 讀寫
        "--output-dir=.qa-artifacts/playwright"
      ],
      "enabled": true
    },
    // 官方套件/框架文件查詢(依名稱抓最新版本文件),僅供 librarian agent 使用
    // 免費層即可用,速率限制較低;如需更高額度,到 https://context7.com/dashboard 申請 API key,
    // 申請後把下面 command 陣列改成 ["npx", "-y", "@upstash/context7-mcp", "--api-key", "你的KEY"]
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    }
  }
}
