[mysqld]
# mysqld — 核心基礎設定
# 用途：指定 MariaDB 服務在 Linux 作業系統中運行的系統帳號。
# 影響：安全規範。避免使用 root 權限執行資料庫，防止資料庫被駭客攻破時直接取得整台伺服器的 root 權限。
user = mysql

# 用途：記錄資料庫啟動後的進程識別碼（Process ID）。
# 影響：方便系統管理工具（如 systemctl）確認資料庫是否正常運行或執行關閉動作。
pid_file = mysqld.pid

# 用途：開啟 MariaDB 內建的「事件排程器」（類似資料庫版的 Linux Cron job）。
# 影響：開啟後，資料庫會定期在背景執行你所設定的定時 SQL 任務（例如定時清理過期資料）。
event_scheduler = 1

###
### Connection & Timeout — 連線與逾時控制
###
# 用途：非互動式連線（如：API、應用程式連線）的無活動逾時時間，單位為秒（3600 秒 = 1 小時）。
# 影響：如果程式連上資料庫後擺著不發指令，1 小時後資料庫會主動斷開，釋放連線資源，防止連線被殭屍程式佔滿。
wait_timeout = 3600

# 用途：互動式連線（如：使用 MySQL CLI 終端機、DBeaver 等工具）的無活動逾時時間。
# 影響：與上方類似，管理開發人員手動連線時的閒置自動斷開時間。
interactive_timeout = 3600

# 用途：若啟用，代表等待網路讀取/寫入資料的超時時間，目前維持預設值。
#net_read_timeout = 3600
#net_write_timeout = 3600

# 用途：全伺服器允許的最大同時連線數。
# 影響：提高到 1500 可以應付高流量併發。但要注意，連線數越多，消耗的記憶體就越多，需確保伺服器 RAM 足夠。
max_connections = 1500

# 用途：單一 SQL 語句或單一筆回傳資料的最大資料包限制。
# 影響：放大到 256M 可以允許寫入或讀取極大的資料（如：大文字、Longblob 檔案或大批量的 INSERT）。若超過此限制，連線會報錯斷開。
max_allowed_packet = 256M

# 用途：所有連線執行緒（Threads）總共可以快取打開的資料表數量。
# 影響：設定 3000 可以減少系統頻繁打開/關閉檔案描述符（File Descriptor）的開銷，提高多表查詢與高併發時的效能。
table_open_cache = 3000

# 用途：啟用 執行緒池（Thread Pool） 架構，取代傳統的「一個連線配一個執行緒」模式。
# 影響：高效能關鍵設定。 當面對千人以上高併發連線時，它能有效減少 CPU 頻繁切換執行緒（Context Switch）的損耗，大幅提升系統在高負載下的穩定度。
thread_handling = pool-of-threads

# 用途：快取閒置執行緒的數量。
# 影響：當連線中斷時，執行緒不銷毀而是放入快取供下一個連線使用（註：因為己開啟了 pool-of-threads，此參數在執行緒池架構下影響已不大，但保留無害）。
thread_cache_size = 256

###
### Charset — 語系與編碼
###
# 用途：忽略客戶端自帶的編碼設定，強制使用伺服器端定義的預設語系（通常是 utf8mb4）。
# 影響：防止各個開發端因為自己電腦語系不同（如 Latin1 或 Big5），導致寫入資料庫時產生亂碼。
character_set_client_handshake = 0

###
### SQL — 語法與語義限制
###
# 用途：限制 GROUP_CONCAT() 函數合併字串後的極限長度（預設僅有 1024 位元組）。
# 影響：放大到 64KB，避免在做大量文字合併查詢時，後半段的字串慘遭資料庫無情截斷。
group_concat_max_len = 65536

# 用途：資料表名稱在硬碟上以小寫儲存，且 SQL 查詢時不區分大小寫。
# 影響：跨平台相容性必備（特別是從 Windows 移轉到 Linux 時），需注意該參數通常必須在資料庫初始化前設定，中途修改可能會導致舊表找不到。
lower_case_table_names = 1

### Timezone — 時區設定
# 用途：強制將資料庫系統時區指定為 UTC+8（台灣/北京/新加坡時間）。
# 影響：不受 Linux 宿主機時區變動的影響，確保 NOW()、CURRENT_TIMESTAMP 等時間函數拿到的永遠是標準的本地時間。
default_time_zone = '+8:00'

###
### Logs — 日誌管理 | 疑難排解、效能優化與備份恢復
###
# 用途：指定錯誤日誌的檔名。
# 影響：資料庫崩潰或啟動失敗時，可透過該檔排查異常原因。
log_error = mysql-err.log

# 用途：開啟「慢查詢日誌」功能。
slow_query_log = 1
# 用途：指定慢查詢日誌檔名。
slow_query_log_file = mysql-slow.log
# 用途：定義慢查詢的閾值，單位為秒。
# 影響：效能優化利器。 只要有任何 SQL 執行超過 1 秒，就會被記錄到 mysql-slow.log，方便 DBA 抓出是哪段語法拖垮系統。
long_query_time = 1

# 用途：開啟 Binary Log（二進位日誌），並設定檔案前綴。
# 影響：資料進行主從複製（Replication）以及全量備份後「隨時間點還原（PITR）」的必要基礎。
log_bin = mysql-bin
# 用途：指定 Binlog 記錄格式為「列層級（Row-Based）」。
# 影響：日誌會精準記錄每一行資料被修改後的模樣，雖然檔案較大，但最安全、最不會因為非確定性函數（如 UUID()）導致主從資料不一致。
binlog_format = ROW
# 用途：Binlog 檔案的自動過期刪除時間（604800 秒 = 7 天）。
# 影響：防止 Binlog 無限制增長，最後把硬碟空間撐爆。
binlog_expire_logs_seconds = 604800
# 用途：每發生 1 次事務提交（Commit），就強制作業系統將 Binlog 寫入硬碟。
# 影響：最高安全級別，確保即便突發斷電，也絕對不丟失任何已提交的事務，缺點是會帶來頻繁的硬碟 I/O 壓力。
sync_binlog = 1
# 用途：信任預存程序/函數的建立者。
# 影響：當開啟 Binlog 時，預設不允許建立未標明特性的自訂函數（防複製出錯），設為 1 可以讓開發人員自由建立 Trigger 或 Function。
log_bin_trust_function_creators = 1

###
### Audit Log — 安全審計日誌 | 用於監控和記錄誰對資料庫做了什麼，通常是為了通過資安法規與合規性檢查（如 ISO 27001）。
###
# 用途：載入 MariaDB 的審計外掛模組。
plugin_load_add = server_audit
# 用途：指定審計範圍，這裡指定記錄「使用者連線/斷開（CONNECT）」以及「存取了哪些資料表（TABLE）」。
server_audit_events = 'CONNECT,TABLE'
# 用途：將審計結果輸出為實體檔案。
server_audit_output_type = file
# 用途：指定審計日誌的路徑與檔名。
server_audit_file_path = mysql-audit.log
# 用途：當審計日誌達到 500MB 時進行檔案輪替（Rotate）。
server_audit_file_rotate_size = 500M
# 用途：保留歷史審計檔案的數量為 1 個（即保留當前和上一個）。
server_audit_file_rotations = 1
# 用途：正式啟用審計日誌功能。
# 影響：開啟後會詳細記錄所有使用者的登入軌跡與改表行為，但會消耗些許 CPU 與硬碟寫入效能。
server_audit_logging = 1

###
### Storage Engines — 儲存引擎優化 | 針對主要的儲存引擎 InnoDB（以及傳統擴充）進行調校
###
# 用途：載入 FederatedX 儲存引擎。
# 影響：允許這台 MariaDB 建立「遠端對應表」，直接讀取或寫入另一台遠端資料庫的資料，類似 Oracle 的 DBLink。
plugin_load_add = ha_federatedx
# 用途：InnoDB 寫入資料時，繞過 Linux 作業系統層級的頁面緩衝區（Page Cache），直接寫入實體磁碟。
# 影響：避免了資料庫與作業系統重複雙重快取（Double Buffering）同一份資料，能顯著提升 I/O 寫入效能並釋放 Linux 記憶體。
innodb_flush_method = O_DIRECT
# 用途：每次事務提交時，都將 InnoDB Redo Log 刷入硬碟。
# 影響：符合 ACID 規範的極致安全設定。 保證斷電時資料不遺失。若遇到硬碟效能瓶頸，通常會將此調整為 2（每秒寫入）。
innodb_flush_log_at_trx_commit = 1
# 用途：將自增鎖（Auto-Increment Lock）設為「交錯模式（Interleaved）」。
# 影響：在高流量、多線程併發執行 INSERT 時，不再互相阻塞等待自增 ID，大幅提升寫入吞吐量，此設定與 binlog_format = ROW 是較佳組合。
innodb_autoinc_lock_mode = 2
# 用途：InnoDB 用來快取尚未提交之事務日誌（Redo Log）的記憶體大小。
# 影響：設為 64M 非常充裕，允許大型事務在提交前都待在記憶體裡，不用頻繁寫入硬碟，減少磁碟 I/O。
innodb_log_buffer_size = 64M
# 用途：Redo Log 檔案（ib_logfile0 等）的單個大小。
# 影響：目前的1G設定值偏大，但是設定偏大的好處是允許資料庫積攢更多修改後再一次性寫入硬碟（Checkpoint 減少）提升寫入效能；
#       壞處是如果突然異常斷電，重啟時的資料庫自我修復（Crash Recovery）時間會拉長。
innodb_log_file_size = 1G
# 用途：將 InnoDB 預設的資料頁大小由 16KB 改為 32KB。
# 影響：注意：這也是必須在資料庫初始化前決定的設定。 較大的 Page Size 適合現代高速 SSD 硬碟以及擁有大量寬資料行（欄位很多或很長）的資料表，能提升連續讀寫的效率。
innodb_page_size = 32K
# 用途：InnoDB 儲存引擎最核心的記憶體緩衝池大小，用來快取資料表的資料與索引。
# 影響：決定 MariaDB 效能的最關鍵參數。 快取設為 8G，代表常讀寫的資料都能直接在記憶體中命中，不需讀取實體硬碟，依據當前 8G 設定，宿主機總 RAM 至少需準備 12GB ~ 16GB 左右。
innodb_buffer_pool_size = 8G

###
### Memory Buffers — 記憶體緩衝區 | 調校各個線程、查詢與排序所需的記憶體資源。
###
# 用途：每個執行緒進行「順序掃描（Sequential Scan）」時分配的緩衝區大小。
read_buffer_size = 2M
# 用途：每個執行緒在進行「排序後的隨機讀取」時分配的緩衝區大小。
read_rnd_buffer_size = 1M
# 用途：每個執行緒在進行 ORDER BY 或 GROUP BY 排序操作時分配的記憶體。
# 影響：以上三者都是每條連線獨立分配（Per-Thread），調大可以加快複雜查詢與排序速度，但若併發連線數高（如 1500），這些緩衝區會相乘，依照當前配置狀況可能會瞬間使用好幾個 GB 的 RAM，必須謹慎 (1500 x 4M = 6GB)。
sort_buffer_size = 4M
# 用途：記憶體中內建臨時表（Memory Temporary Table）的最大上限。
# 影響：當執行複雜的大型 Join 或 Group 查詢時，MariaDB 會在記憶體建立臨時表。如果臨時表大小超過 1GB，資料庫就會被迫改寫到慢速的硬碟（Disk）上，放寬到 1GB 可確保多數複雜查詢都在能記憶體中快速完成。
max_heap_table_size = 1024M
tmp_table_size = 1024M
# 用途：每個連線快取未提交之 Binlog 內容的記憶體大小。預設 32K 已足夠應付多數常規交易。
binlog_cache_size = 32K

# 用途與影響：這三個參數用來設定「查詢快取（Query Cache）」，會直接把整個 SELECT 的結果快取在記憶體中。
# 現實狀況：在現代高併發、高頻率寫入的環境中，只要資料表一有變動，相關的所有快取都會被強制清空（Lock 鎖定）。
#          這往往會導致嚴重的執行緒爭搶（Lock Contention），基於此原因所以 MySQL 8.0 移除相關功能，新版 MariaDB 預設也不建議開啟。
#query_cache_size = 256M
#query_cache_limit = 2M
#query_cache_min_res_unit = 5k

###
### Security — 資安防禦
###
# 用途：禁用 LOAD DATA LOCAL INFILE 命令。
# 影響：極重要的安全防禦，防止惡意客戶端利用 SQL 注入等漏洞，透過此指令遠端竊取、讀取 MariaDB 宿主機上的敏感本地檔案（如 /etc/passwd）。
local_infile = 0

###
### Replication / GTID — 全域交易識別與複製設定
###
# 用途：這台資料庫在整個叢集/複製架構中的獨一無二身份證字號（ID）。
# 影響：主從複製架構中，所有參與者的 server_id 絕對不能重複，否則會造成同步錯亂。
server_id = 1
# 用途：啟用全域交易識別碼（GTID）的嚴格模式。
# 影響：在主從複製中，如果 Slave（從庫）遇到任何 GTID 序列不一致或跳過的錯誤，會立刻中止複製並報錯，而不是假裝沒事繼續同步，這確保了主從資料的絕對嚴謹與一致性。
gtid_strict_mode = 1
# 用途：GTID 的複製域 ID。
# 影響：在使用 MariaDB 的多源複製（Multi-Source Replication，從多台主庫同步到一台從庫）時，用來區分不同的複製串流，避免 GTID 衝突。
gtid_domain_id = 1
# 用途：關閉主庫的半同步複製（Semi-Synchronous Replication）功能。
# 影響：目前設為 0 代表此時走的是非同步複製（Asynchronous），主庫提交事務時快速過關，不會等待任何從庫（Slave）寫入完成的回應，速度最快，但主庫若突然異常，則從庫有可能會漏掉一小段剛寫入的資料。
rpl_semi_sync_master_enabled = 0
# 用途：定義半同步複製時，主庫等待從庫回應的切入點。
# 影響：雖然此份設定檔 的 rpl_semi_sync_master_enabled 為 0 ，但若未來改成 1 開啟，AFTER_SYNC 即代表主庫把 Binlog 存到硬碟後，就會開始等從庫的 ACK（確認收到）信號，拿到信號後主庫才會在引擎層正式 Commit。
#       這能有效防止「幻讀（Phantom Read）」現象，是目前公認最安全的半同步策略。
rpl_semi_sync_master_wait_point = AFTER_SYNC
# 用途：讓作為從庫（Slave）的節點，把從主庫同步過來的變更，也寫一份到自己的 Binlog 裡。
# 影響：當架構是鏈狀複製（A 主 -> B 從/中繼主 -> C 從）或者雙主雙活（Multi-Master）時，這是必須開啟的參數。
log_slave_updates = 1





